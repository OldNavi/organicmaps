<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
  <!-- Variant-only overrides for the `profileable` build type.
    Enables Studio Profiler / simpleperf on this Release-like build without
    touching the production manifest. -->
  <application>
    <provider
      android:name="app.organicmaps.cluster.NavigationProvider"
      android:authorities="${applicationId}.navi"
      tools:replace="android:authorities" />
    <profileable
      android:shell="true"
      android:enabled="true"
      tools:targetApi="29" />
  </application>
</manifest>
